<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!--
        T005 — Permisos de dispositivo declarados (RF-043: Galería, Cámara,
        GPS, Podómetro). La SOLICITUD en runtime post-login y el manejo de
        denegación/guía (RF-044/RF-045) se implementan en el Módulo 2
        (Permisos del Dispositivo, T036-T044), no en esta fase de Setup.
    -->

    <!-- Cámara (RF-025) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        Galería: en Android 13+ (API 33+) el Photo Picker no requiere este
        permiso (research.md §1.3); se declara igual, acotado con
        maxSdkVersion, para las versiones anteriores.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- GPS / Ubicación (RF-018, Puntos Verdes Cercanos) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!--
        Podómetro: ACTIVITY_RECOGNITION es obligatorio desde Android 10
        (API 29) para leer Sensor.TYPE_STEP_COUNTER (research.md §1.1).
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- Red: verificación con EcoGPT y sincronización de Puntos Verdes -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".EcoSmartApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.EcoSmart">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EcoSmart">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Deshabilita el auto-init de WorkManager: EcoSmartApplication lo
            inicializa a mano con HiltWorkerFactory (T059), ver su KDoc.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
