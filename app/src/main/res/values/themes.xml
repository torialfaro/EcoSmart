<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema base solo para la ventana previa a que Compose tome el control
        (windowBackground, status bar) — el theming real de la UI vive en
        presentation/theme/Theme.kt (tarea T020, Fase 2 Foundational).
    -->
    <!--
        Parent de plataforma (no de la librería Material Components, que
        este proyecto no agrega como dependencia por ser 100% Jetpack
        Compose) para no requerir una lib extra solo para este estilo previo.
    -->
    <style name="Theme.EcoSmart" parent="android:Theme.Material.Light.NoActionBar">
        <!-- RF-083: mismo verde-crema que el fondo del mockup, para no ver un destello blanco al abrir. -->
        <item name="android:windowBackground">#F1F4E5</item>
        <item name="android:statusBarColor">#F1F4E5</item>
        <item name="android:navigationBarColor">#E6EDDC</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
