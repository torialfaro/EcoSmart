# Copiar a .env para desarrollo local (nunca commitear el .env real).
# En Render, estas mismas 2 variables se cargan como Environment Variables
# del servicio, no como archivo.

# API key real de Gemini (Google AI Studio, capa gratuita — no pide
# tarjeta de crédito) — https://aistudio.google.com/apikey
# Solo vive acá (servidor); nunca se expone al cliente Android.
GEMINI_API_KEY=reemplazar-con-la-key-real

# Secreto compartido inventado por vos (cualquier string largo y random).
# Debe coincidir EXACTO con ECOGPT_API_KEY en local.properties del proyecto Android.
ECOGPT_SHARED_API_KEY=elegi-un-secreto-largo-y-random

# Firebase (spec 002-firestore-datos-usuario) — ver ../specs/002-firestore-datos-usuario/quickstart.md §2/§5
# Ruta al JSON de cuenta de servicio generado en Firebase Console → Project Settings →
# Service Accounts → "Generate new private key". Nunca se commitea.
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# Solo en desarrollo local, apuntando al emulador de Firestore (quickstart.md §4).
# DEBE estar ausente en Render (producción usa el Firestore real del proyecto).
FIRESTORE_EMULATOR_HOST=localhost:8080
